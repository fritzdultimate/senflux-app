@php
    $tierColors = ['#60a5fa', '#9B7DFF', '#fbbf24'];
    $accent = $tierColors[$this->subscription->packTier->sort_order ?? 0] ?? '#6b7280';

    $statusMap = [
        'active'             => ['label' => 'Active',          'color' => '#22c55e', 'pulse' => false],
        'in_renewal_window'  => ['label' => 'Renewal Window',  'color' => '#f59e0b', 'pulse' => true],
        'renewed'            => ['label' => 'Renewed',         'color' => '#6b7280', 'pulse' => false],
        'closed'             => ['label' => 'Closed',          'color' => '#6b7280', 'pulse' => false],
        'expired'            => ['label' => 'Expired',         'color' => '#6b7280', 'pulse' => false],
        'refunded'           => ['label' => 'Refunded',        'color' => '#6b7280', 'pulse' => false],
    ];
    $status = $statusMap[$this->subscription->status->value] ?? ['label' => $this->subscription->status->label(), 'color' => '#6b7280', 'pulse' => false];
@endphp

<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 lg:px-0">

